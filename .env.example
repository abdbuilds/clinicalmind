# ClinicalMind environment variables — copy this file to `.env` and fill in real values.
# NEVER commit the real .env file (it is git-ignored).

# AWS region where all resources live
AWS_REGION=us-east-1

# Your 12-digit AWS account ID (from: aws sts get-caller-identity)
AWS_ACCOUNT_ID=

# S3 bucket holding FHIR patient files and guideline documents
S3_BUCKET_NAME=

# Bedrock Knowledge Base ID (created in Week 2)
KNOWLEDGE_BASE_ID=

# Bedrock Agent ID (created in Week 3)
AGENT_ID=

# Bedrock Guardrail ID (created in Week 4)
GUARDRAIL_ID=
